### ============================================
### AUTHENTICATION ENDPOINTS
### ============================================

### 1. Register a New User (with tenantCode)
# @name register
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "HTOO MYAT",
  "email": "htoomyat@gmail.com",
  "password": "password123",
  "tenantName": "My Business",
  "tenantCode": "MYBIZ"
}

### 2. Login (with optional tenantCode)
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "htoomyat@gmail.com",
  "password": "password123",
  "tenantCode": "MYBIZ"
}

### 2a. Verify Email with OTP
# @name verifyEmail
POST {{baseUrl}}/auth/verify-email
Content-Type: application/json

{
  "code": "123456"
}

### 2b. Resend OTP
# @name resendOtp
POST {{baseUrl}}/auth/resend-otp
Authorization: Bearer {{authToken}}

### 2c. Forgot Password
# @name forgotPassword
POST {{baseUrl}}/auth/forgot-password
Content-Type: application/json

{
  "email": "htoomyat@gmail.com"
}

### 2d. Reset Password
# @name resetPassword
POST {{baseUrl}}/auth/reset-password
Content-Type: application/json

{
  "email": "htoomyat@gmail.com",
  "code": "123456",
  "newPassword": "newpassword123"
}

### 2e. Get Current User Info
# @name getMe
GET {{baseUrl}}/auth/me
Authorization: Bearer {{authToken}}

### 2f. Google OAuth
# @name googleAuth
GET {{baseUrl}}/auth/google

